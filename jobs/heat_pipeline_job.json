{
  "name": "dsai3202-project-heat-60100554",
  "description": "Phase 1: ingest ERA5 -> silver -> quality gate -> gold -> features_v1",
  "max_concurrent_runs": 1,
  "timeout_seconds": 43200,
  "parameters": [
    {"name": "run_mode", "default": "prod"},
    {"name": "source_version", "default": "v1"}
  ],
  "git_source": {
    "git_url": "https://github.com/amalhaji/dsai3202-heat-stress-project",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "job_clusters": [
    {
      "job_cluster_key": "single_node",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 0,
        "data_security_mode": "SINGLE_USER",
        "spark_conf": {"spark.databricks.cluster.profile": "singleNode", "spark.master": "local[*]"},
        "custom_tags": {"ResourceClass": "SingleNode", "project": "dsai3202-heat"}
      }
    }
  ],
  "tasks": [
    {"task_key": "01_ingest", "job_cluster_key": "single_node",
     "notebook_task": {"notebook_path": "notebooks/01_ingest_era5", "source": "GIT", "base_parameters": {"run_id": "{{job.run_id}}"}},
     "libraries": [{"pypi": {"package": "cdsapi>=0.7.4"}}]},
    {"task_key": "02_silver", "depends_on": [{"task_key": "01_ingest"}], "job_cluster_key": "single_node",
     "notebook_task": {"notebook_path": "notebooks/02_silver_transform", "source": "GIT", "base_parameters": {"run_id": "{{job.run_id}}"}}},
    {"task_key": "03_validate", "depends_on": [{"task_key": "02_silver"}], "job_cluster_key": "single_node",
     "notebook_task": {"notebook_path": "notebooks/03_validate", "source": "GIT", "base_parameters": {"run_id": "{{job.run_id}}"}}},
    {"task_key": "04_publish_gold", "depends_on": [{"task_key": "03_validate"}], "run_if": "ALL_SUCCESS", "job_cluster_key": "single_node",
     "notebook_task": {"notebook_path": "notebooks/04_publish_gold", "source": "GIT", "base_parameters": {"run_id": "{{job.run_id}}"}}},
    {"task_key": "05_features", "depends_on": [{"task_key": "04_publish_gold"}], "run_if": "ALL_SUCCESS", "job_cluster_key": "single_node",
     "notebook_task": {"notebook_path": "notebooks/05_features", "source": "GIT", "base_parameters": {"run_id": "{{job.run_id}}"}}}
  ]
}
